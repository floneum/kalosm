{
  "name": "rookie-chess-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "bench": "node --import tsx tests/benchmark.ts",
    "bench:workers": "node --import tsx tests/worker-benchmark.ts",
    "perf": "node --import tsx tests/performance.ts",
    "build:wasm": "./scripts/build-wasm.sh",
    "verify": "npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.6",
    "@fontsource/instrument-serif": "^5.2.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "chess.js": "^1.4.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  }
}
